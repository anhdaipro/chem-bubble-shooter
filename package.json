{
  "name": "chem-bubble-shooter",
  "private": true,
  "version": "1.0.0",
  "description": "Chemistry Bubble Shooter - A fun educational game",
  "author": "Pham Nguyen",
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "dev:electron": "concurrently \"vite\" \"electron .\"",
    "build:electron": "npm run build && electron-builder",
    "build:mac": "npm run build && electron-builder --mac dmg zip",
    "build:mas": "npm run build && electron-builder --mac mas",
    "build:win-store": "npm run build && electron-builder --win appx"
  },
  "build": {
    "appId": "com.chembubbleshooter.app",
    "productName": "Chem Bubble Shooter",
    "buildVersion": "5",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "package.json"
    ],
    "mac": {
      "icon": "build/icon.png",
      "target": [
        "dmg",
        "zip",
        "mas"
      ],
      "category": "public.app-category.educational-games",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "mas": {
      "icon": "build/icon.png",
      "entitlements": "build/entitlements.mas.plist",
      "entitlementsInherit": "build/entitlements.mas.inherit.plist",
      "provisioningProfile": "build/embedded.provisionprofile",
      "hardenedRuntime": false,
      "category": "public.app-category.educational-games"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "appx": {
      "applicationId": "YourPublisherName.ChemBubbleShooter",
      "identityName": "YourPublisherName.ChemBubbleShooter",
      "publisher": "CN=YOUR_PUBLISHER_ID_HERE",
      "publisherDisplayName": "Your Publisher Name"
    },
    "linux": {
      "target": [
        "AppImage",
        "snap"
      ],
      "category": "Education"
    },
    "snap": {
      "summary": "Chemistry Bubble Shooter",
      "confinement": "strict",
      "grade": "stable"
    }
  },
  "dependencies": {
    "@types/matter-js": "^0.20.2",
    "matter-js": "^0.20.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}